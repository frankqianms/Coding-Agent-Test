###############################################
# Application Configuration File
# Purpose: Store application settings and parameters
# Location: src/data/config/
# Format: Key-Value pairs
###############################################

# Application Information
app.name=Coding Agent Test Application
app.version=1.0.0
app.author=Coding Agent Team

# Database Configuration
# Note: These are example configurations
db.host=localhost
db.port=5432
db.name=testdb
db.username=admin
# db.password is stored in secure vault (not in this file)

# Logging Configuration
log.level=INFO
log.file.path=/var/log/app.log
log.console.enabled=true

# Performance Settings
# Maximum number of concurrent threads
thread.pool.size=10
# Connection timeout in milliseconds
connection.timeout=5000

# Feature Flags
# Enable or disable specific features
feature.advanced_analytics=true
feature.debug_mode=false
feature.experimental=false

###############################################
# End of Configuration
# Last Updated: 2024
###############################################
